<?xml version="1.0" encoding="UTF-8"?>
<!--
  控制台日志格式：时间 级别 [线程] [服务名:端口] logger - 消息
  其中 [de-stock-service:8083] 与 [de-stock-service:8183] 便于观察请求落在了哪个实例
-->
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <springProperty scope="context" name="SERVER_PORT" source="server.port" defaultValue="?"/>
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%thread] [${APP_NAME}:${SERVER_PORT}] %logger{20} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
